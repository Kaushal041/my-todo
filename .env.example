# Zenith Productivity OS - Environment Configuration (Optional)
# The application runs 100% locally in your browser with zero configuration required.
# Configure the variables below if you wish to enable cloud synchronization or external Gemini AI capabilities.

# Optional: Supabase Cloud Synchronization
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Google Gemini AI API Key (for automated generative task breakdowns)
GEMINI_API_KEY=your-gemini-api-key
