# Zenith Productivity OS - Environment Configuration
# Keep these server-only variables out of client code and never prefix them with NEXT_PUBLIC_.

# MongoDB Atlas cloud sync (all four values are required to enable private sync)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=zenith
APP_PASSWORD=replace-with-a-private-password-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: Google Gemini AI API Key (for automated generative task breakdowns)
GEMINI_API_KEY=your-gemini-api-key
